# Copy to .env. Used by docker compose; the API reads backend/.env separately.

POSTGRES_USER=feedbackhub
POSTGRES_PASSWORD=feedbackhub
POSTGRES_DB=feedbackhub
POSTGRES_PORT=5432

KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

API_PORT=3000
WEB_PORT=4200

# Seeded as an administrator every time the API starts. The API creates the Keycloak
# account if it is missing and sets its password to this value.
BOOTSTRAP_ADMIN_EMAIL=admin@feedbackhub.local
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!demo

# --- Social login (Google) -----------------------------------------------------------
# Off by default: without a Google project there is nothing to sign in to. To enable it,
# create an OAuth client at https://console.cloud.google.com/apis/credentials with the
# authorised redirect URI
#
#     http://localhost:8080/realms/feedbackhub/broker/google/endpoint
#
# then set all three below and re-import the realm (see README). These are read by
# Keycloak at realm import; the realm file itself holds only placeholders.
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

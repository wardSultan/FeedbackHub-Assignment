# Copy to .env and adjust. Never commit the result — .env is gitignored.

NODE_ENV=development
PORT=3000

# The API's own database. Keycloak uses a separate database on the same server.
DATABASE_URL=postgresql://feedbackhub:feedbackhub@localhost:5432/feedbackhub

# Comma-separated allowlist. No wildcard.
CORS_ORIGINS=http://localhost:4200

# --- Identity ------------------------------------------------------------------
# Must match the `iss` claim exactly, including port and scheme.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/feedbackhub
KEYCLOAK_AUDIENCE=feedbackhub-api

# --- Administrator bootstrap ---------------------------------------------------
# Seeded at start-up: the API creates this account in Keycloak if it is missing, sets its
# password to the value below, and makes the local record an administrator. Idempotent, so
# it runs on every boot. Clear the password to turn seeding off — the email alone still
# promotes that person the first time they sign in.
BOOTSTRAP_ADMIN_EMAIL=admin@feedbackhub.local
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!demo

# Realm-administrator credentials the seeding uses. Only that one code path needs them.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak as the API reaches it, which under Docker is not the issuer's `localhost`.
# Defaults to the issuer's origin, so this stays commented out for a local API.
# KEYCLOAK_BASE_URL=http://localhost:8080

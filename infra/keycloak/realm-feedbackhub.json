          "value": "Passw0rd!demo",
          "temporary": false
        }
      ],
      "id": "00000000-0000-4000-a000-000000005e01"
    },
    {
      "username": "second@feedbackhub.local",
      "email": "second@feedbackhub.local",
      "firstName": "Sam",
      "lastName": "Second",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Passw0rd!demo",
          "temporary": false
        }
      ],
      "id": "00000000-0000-4000-a000-000000005e02"
    }
  ]
}
